def download(url, destination, label):
    destination.parent.mkdir(parents=True, exist_ok=True)
    say(f"downloading {label} ...")
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    partial = destination.with_suffix(destination.suffix + ".part")
    try:
        with urllib.request.urlopen(request, timeout=60) as response, \
                open(partial, "wb") as output:
            total = int(response.headers.get("Content-Length") or 0)
            done = 0
            while True:
                chunk = response.read(1024 * 256)
                if not chunk:
                    break
                output.write(chunk)
                done += len(chunk)
                if total and done % (8 * 1024 * 1024) < 1024 * 256:
                    say(f"  {human_size(done)} / {human_size(total)}")
        partial.replace(destination)
    except Exception as exc:
        partial.unlink(missing_ok=True)
        die(f"download failed: {exc}")
    return destination


def extract_widget(installer, destination):
    if not have("7z"):
        die("7z is required to unpack the Lovense installer (install p7zip)")
    say(f"unpacking {installer.name} ...")
    with tempfile.TemporaryDirectory(prefix="phonecam-") as tmp:
        result = subprocess.run(["7z", "x", "-y", f"-o{tmp}", str(installer)],
                                stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        if result.returncode != 0:
            die(f"7z failed: {result.stderr.decode(errors='replace').strip()}")
        candidates = sorted(Path(tmp).rglob("dist/index.html"))
        if not candidates:
            die("no widget (dist/index.html) found inside the installer")
        source = candidates[0].parent
        destination.mkdir(parents=True, exist_ok=True)
        shutil.copytree(source, destination, dirs_exist_ok=True)
    ok(f"widget installed: {destination} ({widget_version(destination)})")


def cmd_lovense_setup(args):
    widget = find_widget()
    if args.installer:
        installer = Path(args.installer).expanduser()
        if not installer.is_file():
            die(f"installer not found: {installer}")
        target = Path(args.to).expanduser() if args.to else DATA_DIR / "widget"
        extract_widget(installer, target)
        return
    if widget is not None and not args.download:
        ok(f"widget already installed: {widget} ({widget_version(widget)})")
        say("  use --download to refresh it from the official installer")
        return
    target = Path(args.to).expanduser() if args.to else DATA_DIR / "widget"
    installer = CACHE_DIR / "Lovense_OBS_Toolset_x64.exe"
    if not installer.is_file() or args.force:
        download(TOOLSET_URL, installer, "Lovense OBS Toolset (~81 MiB)")
    else:
        say(f"using cached installer: {installer}")
    extract_widget(installer, target)


def find_loaded_extension():
    """Return the unpacked Lovense extension that Chrome has loaded, if any."""
    roots = [HOME / ".config" / "google-chrome",
             HOME / ".config" / "google-chrome-beta",
             HOME / ".config" / "google-chrome-unstable",
             HOME / ".config" / "chromium"]
    for root in roots:
        for prefs in root.glob("*/Preferences"):
            try:
                data = json.loads(prefs.read_text())
            except Exception:
                continue
            settings = data.get("extensions", {}).get("settings", {})
            for entry in settings.values():
                path = entry.get("path") or ""
                if "lovense" not in path.lower():
                    continue
                candidate = Path(path)
                if (candidate / "manifest.json").is_file():
                    return candidate
    return None


def patch_extension(directory):
    page = directory / "pages" / "chrome_background.html"
    if not page.is_file():
        die(f"not an unpacked Lovense extension: {directory}")
    text = page.read_text()
    match = re.search(r'allow="([^"]*)"', text)
    if not match:
        warn(f"no allow= attribute in {page}; nothing to patch")
        return False
    permissions = [part.strip() for part in match.group(1).split(";") if part.strip()]
    missing = [perm for perm in ("local-network-access", "loopback-network")
               if perm not in permissions]
    if not missing:
        ok("extension already patched for Local Network Access")
        return False
    permissions.extend(missing)
    updated = text[:match.start()] + 'allow="' + ";".join(permissions) + '"' + text[match.end():]
    page.write_text(updated)
    ok(f"patched allow= in {page}")
    return True


def install_extension(target, force=False):
    target = Path(target).expanduser()
    if target.is_dir() and not force:
        patch_extension(target)
        return target
    archive = CACHE_DIR / "lovense_cam.zip"
    if not archive.is_file() or force:
        download(EXTENSION_URL, archive, "Lovense Cam extension (~3.3 MiB)")
    else:
        say(f"using cached extension: {archive}")
    say(f"unpacking {archive.name} ...")
    target.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(archive) as bundle:
        bundle.extractall(target)
    patch_extension(target)
    return target


def cmd_lovense_extension(args):
    if args.dir:
        directory = Path(args.dir).expanduser()
        if not directory.is_dir():
            die(f"directory not found: {directory}")
        patch_extension(directory)
    else:
        loaded = find_loaded_extension()
        if loaded is not None and not args.force:
            ok(f"found the extension loaded by Chrome: {loaded}")
            changed = patch_extension(loaded)
            directory = loaded
            if changed:
                say()
                warn("reload the extension in chrome://extensions (click Reload)")
        else:
            directory = install_extension(DATA_DIR / "extension", force=args.force)
            say()
            say("Load the extension in Chrome:")
            say("  1. open chrome://extensions")
            say("  2. enable Developer mode")
            say(f"  3. Load unpacked -> {directory}")
            say("  4. keep the folder in place, Chrome loads it from disk")
    if not chrome_flags_ok():
        say()
        warn("Chrome Local Network Access is not disabled yet")
        say("  run: phonecam doctor   (it explains the fix)")


