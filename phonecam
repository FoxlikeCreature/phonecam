def phone_apply(cfg, scene, activate=False):
    push, view = phone_urls(cfg)
    with Obs() as obs:
        created = ensure_scene(obs, scene)
        if created:
            ok(f"scene created: {scene}")
        item_id, changed = ensure_browser_source(obs, scene, PHONE_SOURCE, view, 1920, 1080)
        cw, ch = fit_source(obs, scene, item_id)
        if activate:
            obs.call("SetCurrentProgramScene", sceneName=scene)
        state = "created" if created or changed else "updated"
        ok(f"OBS source {PHONE_SOURCE} {state} in scene {scene!r} (canvas {cw}x{ch})")
    return push, view


def cmd_phone_new(args):
    cfg = load_config()
    if args.room:
        room = re.sub(r"[^A-Za-z0-9]", "", args.room)
        if not room:
            die("room id must contain letters or digits")
        cfg["room"] = room
    else:
        cfg.setdefault("room", "pc" + secrets.token_hex(4))
    cfg["back"] = bool(args.back)
    cfg["bitrate"] = args.bitrate
    cfg["relay"] = bool(args.relay)
    cfg["p2p"] = bool(args.p2p)
    cfg["codec"] = args.codec
    if args.scene:
        cfg["scene"] = args.scene
    save_config(cfg)
    push, view = phone_urls(cfg)
    say(f"room:    {cfg['room']}")
    say(f"phone:   {push}")
    say(f"OBS:     {view}")
    qr = make_qr(push)
    if qr:
        say(f"QR file: {qr}")
    say()
    print_qr_ansi(push)
    if getattr(args, "obs", False):
        phone_apply(cfg, args.scene, args.activate)


