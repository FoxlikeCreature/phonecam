def lovense_apply(scene, activate=False):
    widget = find_widget()
    if widget is None:
        die("Lovense widget is not installed; run: phonecam lovense setup")
    with Obs() as obs:
        created = ensure_scene(obs, scene)
        if created:
            ok(f"scene created: {scene}")
        cw, ch = canvas_size(obs)
        item_id, changed = ensure_browser_source(
            obs, scene, LOVENSE_SOURCE, lovense_url(), cw, ch, css=LOVENSE_CSS)
        fill_canvas(obs, scene, item_id)
        obs.call("SetSceneItemIndex", sceneName=scene, sceneItemId=item_id,
                 sceneItemIndex=0)
        if activate:
            obs.call("SetCurrentProgramScene", sceneName=scene)
        state = "created" if changed else "updated"
        ok(f"OBS source {LOVENSE_SOURCE} {state} in scene {scene!r} "
           f"(topmost, canvas {cw}x{ch})")


