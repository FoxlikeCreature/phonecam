def cmd_start(args):
    cfg = load_config()
    if not cfg.get("room"):
        cfg["room"] = "pc" + secrets.token_hex(4)
        save_config(cfg)
        warn(f"new room created: {cfg['room']}")

    say(f"{APP} {VERSION}")
    say(f"room: {cfg['room']}")

    widget = find_widget()
    if widget:
        ok(f"widget: {widget} ({widget_version(widget)})")
    else:
        warn("widget: not installed (phonecam lovense setup)")
        say("        OBS will only show the phone feed")

    ensure_relay()

    scene = scene_name(cfg, args.scene)
    if not args.no_obs:
        try:
            push, view = phone_urls(cfg)
            with Obs() as obs:
                ensure_scene(obs, scene)
                item_id, _ = ensure_browser_source(obs, scene, PHONE_SOURCE, view,
                                                   1920, 1080)
                fit_source(obs, scene, item_id)
                if widget is not None:
                    cw, ch = canvas_size(obs)
                    item_id, _ = ensure_browser_source(
                        obs, scene, LOVENSE_SOURCE, lovense_url(), cw, ch,
                        css=LOVENSE_CSS)
                    fill_canvas(obs, scene, item_id)
                    obs.call("SetSceneItemIndex", sceneName=scene,
                             sceneItemId=item_id, sceneItemIndex=0)
                if not args.no_activate:
                    obs.call("SetCurrentProgramScene", sceneName=scene)
            ok(f"OBS sources ready in scene {scene!r}")
        except ObsError as exc:
            warn(f"OBS: {exc}")
        except Exception as exc:
            warn(f"OBS: unexpected error: {exc}")

    push, view = phone_urls(cfg)
    say()
    say(f"phone: {push}")
    say(f"OBS:   {view}")
    health = relay_health() or {}
    relay = health.get("relay", {})
    say(f"relay: http://127.0.0.1:{HTTP_PORT}/ "
        f"panels={relay.get('panels', 0)} widgets={relay.get('widgets', 0)}")
    if not args.no_qr:
        qr = make_qr(push)
        if qr:
            say(f"QR file: {qr}")
        say()
        print_qr_ansi(push)


