# --------------------------------------------------------------------------
# Lovense relay: crypto helpers
# --------------------------------------------------------------------------

def encrypt(payload):
    if not HAVE_CRYPTO:
        raise RuntimeError("python-cryptography is required")
    raw = json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode()
    padder = _padding.PKCS7(128).padder()
    raw = padder.update(raw) + padder.finalize()
    encryptor = _Cipher(_algorithms.AES(AES_KEY), _modes.CBC(AES_IV)).encryptor()
    return base64.b64encode(encryptor.update(raw) + encryptor.finalize()).decode()


def decrypt(text):
    if not HAVE_CRYPTO:
        raise RuntimeError("python-cryptography is required")
    data = base64.b64decode(text)
    decryptor = _Cipher(_algorithms.AES(AES_KEY), _modes.CBC(AES_IV)).decryptor()
    raw = decryptor.update(data) + decryptor.finalize()
    unpadder = _padding.PKCS7(128).unpadder()
    return json.loads((unpadder.update(raw) + unpadder.finalize()).decode())


def parse_message(raw):
    if isinstance(raw, bytes):
        raw = raw.decode("utf-8", "replace")
    with contextlib.suppress(Exception):
        return decrypt(raw), "aes"
    with contextlib.suppress(Exception):
        return json.loads(base64.b64decode(raw).decode()), "b64"
    with contextlib.suppress(Exception):
        return json.loads(raw), "json"
    return None, "unknown"


_last_log = {}


def log(message):
    print(f"[{time.strftime('%H:%M:%S')}] {message}", flush=True)


def log_slow(key, message, period=60.0):
    now = time.monotonic()
    if now - _last_log.get(key, 0.0) < period:
        return
    _last_log[key] = now
    log(message)


# --------------------------------------------------------------------------
# Lovense relay: async OBS client
# --------------------------------------------------------------------------

class AsyncObs:
    """Reconnecting obs-websocket client used by the relay."""

    def __init__(self, host, port, password):
        self.url = f"ws://{host}:{port}"
        self.password = password or ""
        self._ws = None
        self._reader = None
        self._pending = {}
        self._lock = asyncio.Lock()
        self._retry_at = 0.0
        self.connected = False
        self.last_error = ""

    @classmethod
    def from_config(cls):
        cfg = obs_websocket_config()
        return cls(RELAY_HOST, int(cfg.get("server_port", 4455)),
                   cfg.get("server_password", ""))

    async def ensure(self):
        if self.connected:
            return True
        async with self._lock:
            if self.connected:
                return True
            if time.monotonic() < self._retry_at:
                return False
            try:
                await self._handshake()
                return True
            except Exception as exc:
                self.last_error = str(exc)
                self._retry_at = time.monotonic() + 10.0
                return False

    async def _handshake(self):
        ws = await websockets.connect(self.url, open_timeout=3, max_size=None,
                                      ping_interval=20, ping_timeout=20)
        try:
            hello = json.loads(await asyncio.wait_for(ws.recv(), 3))["d"]
            ident = {"rpcVersion": 1, "eventSubscriptions": 0}
            auth = hello.get("authentication")
            if auth:
                secret = base64.b64encode(
                    hashlib.sha256((self.password + auth["salt"]).encode()).digest()).decode()
                ident["authentication"] = base64.b64encode(
                    hashlib.sha256((secret + auth["challenge"]).encode()).digest()).decode()
            await ws.send(json.dumps({"op": 1, "d": ident}))
            response = json.loads(await asyncio.wait_for(ws.recv(), 3))
            if response.get("op") != 2:
                raise RuntimeError("obs-websocket rejected the connection")
        except Exception:
            await ws.close()
            raise
        self._ws = ws
        self.connected = True
        self.last_error = ""
        self._reader = asyncio.create_task(self._read(ws))

    async def _read(self, ws):
        try:
            async for raw in ws:
                try:
                    message = json.loads(raw)
                except Exception:
                    continue
                if message.get("op") == 7:
                    future = self._pending.pop(message["d"].get("requestId"), None)
                    if future and not future.done():
                        future.set_result(message["d"])
        except Exception:
            pass
        finally:
            self.connected = False
            self._ws = None
            for future in self._pending.values():
                if not future.done():
                    future.set_exception(ObsError("OBS connection lost"))
            self._pending.clear()

    async def call(self, request, timeout=2.0, **data):
        if not await self.ensure():
            raise ObsError(self.last_error or "OBS is not connected")
        loop = asyncio.get_running_loop()
        future = loop.create_future()
        request_id = f"relay-{uuid.uuid4()}"
        self._pending[request_id] = future
        try:
            await self._ws.send(json.dumps({
                "op": 6,
                "d": {"requestType": request, "requestId": request_id,
                      "requestData": data},
            }))
            message = await asyncio.wait_for(future, timeout)
        finally:
            self._pending.pop(request_id, None)
        status = message.get("requestStatus", {})
        if not status.get("result"):
            raise ObsError(f"{request}: {status.get('comment') or status.get('code')}")
        return message.get("responseData", {})


async def obs_answer(obs, request_type):
    """Turn a Lovense Toolset request into live OBS data."""
    if request_type in ("GetOBSApplicationShowStatus", "ActiveOBSCamera",
                        "ShowOBSApplication"):
        return {"show": True}
    if request_type == "GetSceneList":
        data = await obs.call("GetSceneList")
        result = {"scenes": [{"name": scene["sceneName"]}
                             for scene in data.get("scenes", []) if scene.get("sceneName")]}
        current = data.get("currentProgramSceneName")
        if current:
            result["currentScene"] = current
        return result
    if request_type == "GetStreamingStatus":
        stream, record, virtual = await asyncio.gather(
            obs.call("GetStreamStatus"), obs.call("GetRecordStatus"),
            obs.call("GetVirtualCamStatus"))
        return {"streaming": bool(stream.get("outputActive")),
                "recording": bool(record.get("outputActive")),
                "isVirtualCam": bool(virtual.get("outputActive"))}
    if request_type == "GetStreamSettings":
        return {"settings": {}}
    if request_type == "GetVirtualCamStatus":
        return {"isVirtualCam": bool((await obs.call("GetVirtualCamStatus")).get("outputActive"))}
    if request_type == "GetRecordingStatus":
        active = bool((await obs.call("GetRecordStatus")).get("outputActive"))
        return {"recording": active, "isRecording": active}
    if request_type == "GetCurrentScene":
        data = await obs.call("GetCurrentProgramScene")
        return {"scene": {"name": data.get("currentProgramSceneName", "")}}
    if request_type == "GetStudioModeStatus":
        return {"studioMode": bool((await obs.call("GetStudioModeEnabled")).get("studioModeEnabled"))}
    if request_type in ("StartVirtualCam", "StopVirtualCam", "StartStreaming",
                        "StopStreaming", "StartRecording", "StopRecording",
                        "StartReplayBuffer", "StopReplayBuffer"):
        await obs.call(request_type)
        return {}
    return {}


async def answer_request(obs, message):
    request_type = message.get("request_type", "")
    response = {"message_id": message.get("message_id"), "status": "ok"}
    if obs is not None:
        try:
            response.update(await obs_answer(obs, request_type))
            return request_type, response
        except Exception as exc:
            log(f"OBS {request_type}: {exc} (fallback)")
    response.update(DEFAULT_RESPONSES.get(request_type, {}))
    return request_type, response


