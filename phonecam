def chrome_flags_ok():
    if not CHROME_FLAGS.is_file():
        return False
    for line in CHROME_FLAGS.read_text(errors="replace").splitlines():
        line = line.strip()
        if line.startswith("#"):
            continue
        if "LocalNetworkAccessChecks" in line:
            return True
    return False


def cmd_doctor(args):
    say(f"{APP} {VERSION} doctor")
    problems = 0

    cfg = load_config()
    if cfg.get("room"):
        ok(f"config: {CONFIG_FILE} (room {cfg['room']})")
    else:
        warn("config: no room yet (phonecam phone new)")
        problems += 1

    missing = []
    versions = []
    if websockets is None:
        missing.append("python-websockets")
    else:
        versions.append(f"websockets {getattr(websockets, '__version__', '?')}")
    if not HAVE_AIOHTTP:
        missing.append("python-aiohttp")
    else:
        import aiohttp
        versions.append(f"aiohttp {aiohttp.__version__}")
    if not HAVE_CRYPTO:
        missing.append("python-cryptography")
    else:
        import cryptography
        versions.append(f"cryptography {cryptography.__version__}")
    if missing:
        fail("python: missing " + ", ".join(missing))
        problems += 1
    else:
        ok("python: " + ", ".join(versions))

    for binary, hint in (("qrencode", "terminal QR codes"),
                         ("7z", "unpacking the Lovense installer")):
        if have(binary):
            ok(f"{binary}: {shutil.which(binary)} ({hint})")
        else:
            warn(f"{binary}: not found ({hint})")

    widget = find_widget()
    if widget:
        ok(f"widget: {widget} ({widget_version(widget)})")
    else:
        fail("widget: not installed (phonecam lovense setup)")
        problems += 1

    health = relay_health()
    if health and health.get("app") == APP:
        relay = health.get("relay", {})
        ok(f"relay: http://127.0.0.1:{HTTP_PORT}/health, "
           f"panels={relay.get('panels', 0)}, widgets={relay.get('widgets', 0)}")
    else:
        warn("relay: not running (phonecam lovense start)")
        problems += 1

    say(f"service: {service_active()} (enabled: {'yes' if service_enabled() else 'no'})")

    try:
        with Obs() as obs:
            inputs = {i["inputName"] for i in obs.call("GetInputList").get("inputs", [])}
            scenes = [s["sceneName"] for s in obs.call("GetSceneList").get("scenes", [])]
            current = obs.call("GetCurrentProgramScene").get("currentProgramSceneName")
            ok(f"obs: connected, scene {current!r}, scenes={len(scenes)}")
            for name in (PHONE_SOURCE, LOVENSE_SOURCE):
                if name in inputs:
                    ok(f"obs source: {name}")
                else:
                    warn(f"obs source: {name} missing (phonecam lovense obs / phonecam phone obs)")
    except ObsError as exc:
        warn(f"obs: {exc}")
        problems += 1

    extension = find_loaded_extension()
    if extension is None:
        candidate = DATA_DIR / "extension"
        extension = candidate if (candidate / "manifest.json").is_file() else None
    if extension is not None:
        page = extension / "pages" / "chrome_background.html"
        if page.is_file() and "local-network-access" in page.read_text():
            ok(f"extension: {extension} (patched)")
        else:
            fail(f"extension: {extension} is not patched (phonecam lovense extension)")
            problems += 1
    else:
        warn("extension: no unpacked Lovense extension found "
             "(phonecam lovense extension)")

    if chrome_flags_ok():
        ok(f"chrome LNA: disabled via {CHROME_FLAGS}")
    else:
        fail(f"chrome LNA: not disabled (needs {CHROME_FLAGS})")
        say('  add this line: --disable-features=LocalNetworkAccessChecks')
        problems += 1

    say()
    if problems:
        warn(f"{problems} thing(s) to fix")
    else:
        ok("everything looks good")


