def widget_dirs():
    env = os.environ.get("PHONECAM_WIDGET_DIR")
    if env:
        yield Path(env)
    yield DATA_DIR / "widget"
    yield SCRIPT_DIR / "widget"
    yield Path("/usr/share/phonecam/widget")


def find_widget():
    for candidate in widget_dirs():
        if (candidate / "index.html").is_file():
            return candidate
    return None


def widget_version(path):
    try:
        for entry in sorted(path.glob("*.txt")):
            text = entry.read_text(errors="replace").strip()
            if re.fullmatch(r"\d+(?:\.\d+)+", text):
                return text
    except Exception:
        pass
    return "unknown"


def make_qr(text):
    if not have("qrencode"):
        return None
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    target = CONFIG_DIR / "qr.png"
    try:
        subprocess.run(["qrencode", "-s", "10", "-m", "4", "-o", str(target), text],
                       check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except subprocess.CalledProcessError:
        return None
    return target


def print_qr_ansi(text):
    if not have("qrencode"):
        warn("qrencode is not installed, cannot draw the QR code in the terminal")
        return
    try:
        result = subprocess.run(["qrencode", "-t", "ANSIUTF8", "-m", "2", text],
                                capture_output=True, text=True, check=True)
        say(result.stdout)
    except subprocess.CalledProcessError as exc:
        warn(f"qrencode failed: {exc}")


# --------------------------------------------------------------------------
# obs-websocket: synchronous client for CLI commands
# --------------------------------------------------------------------------

class ObsError(RuntimeError):
    pass


def obs_websocket_config():
    if not OBS_WS_CONFIG.is_file():
        raise ObsError(f"{OBS_WS_CONFIG} not found; start OBS once")
    try:
        cfg = json.loads(OBS_WS_CONFIG.read_text())
    except Exception as exc:
        raise ObsError(f"cannot read {OBS_WS_CONFIG}: {exc}") from exc
    if not cfg.get("server_enabled"):
        raise ObsError("obs-websocket is disabled; run: phonecam phone enable-ws (then restart OBS)")
    return cfg


class Obs:
    """Minimal synchronous obs-websocket v5 client."""

    def __init__(self, timeout=5.0):
        try:
            from websockets.sync.client import connect
        except ImportError as exc:  # pragma: no cover
            raise ObsError("python-websockets is required") from exc
        self._cfg = obs_websocket_config()
        port = int(self._cfg.get("server_port", 4455))
        self._stack = contextlib.ExitStack()
        try:
            self.ws = self._stack.enter_context(
                connect(f"ws://{RELAY_HOST}:{port}", open_timeout=timeout))
            hello = json.loads(self.ws.recv(timeout=timeout))["d"]
        except Exception as exc:
            self._stack.close()
            raise ObsError(f"OBS is not reachable on {RELAY_HOST}:{port} ({exc})") from exc

        ident = {"rpcVersion": 1, "eventSubscriptions": 0}
        auth = hello.get("authentication")
        if auth:
            password = self._cfg.get("server_password", "")
            secret = base64.b64encode(
                hashlib.sha256((password + auth["salt"]).encode()).digest()).decode()
            ident["authentication"] = base64.b64encode(
                hashlib.sha256((secret + auth["challenge"]).encode()).digest()).decode()
        self.ws.send(json.dumps({"op": 1, "d": ident}))
        try:
            response = json.loads(self.ws.recv(timeout=timeout))
        except Exception as exc:
            self._stack.close()
            raise ObsError(f"OBS handshake failed ({exc})") from exc
        if response.get("op") != 2:
            self._stack.close()
            raise ObsError("OBS rejected the connection (wrong password?)")
        self._request_id = 0

    def call(self, request, timeout=10.0, **data):
        self._request_id += 1
        request_id = f"phonecam-{self._request_id}"
        payload = {"op": 6, "d": {"requestType": request, "requestId": request_id,
                                  "requestData": data}}
        self.ws.send(json.dumps(payload))
        deadline = time.monotonic() + timeout
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                raise ObsError(f"{request}: timeout")
            try:
                raw = self.ws.recv(timeout=left)
            except TimeoutError as exc:
                raise ObsError(f"{request}: timeout") from exc
            message = json.loads(raw)
            if message.get("op") == 5:
                continue
            if message.get("op") == 7 and message["d"].get("requestId") == request_id:
                status = message["d"].get("requestStatus", {})
                if not status.get("result"):
                    raise ObsError(f"{request}: {status.get('comment') or status.get('code')}")
                return message["d"].get("responseData", {})

    def close(self):
        self._stack.close()

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()


def ensure_scene(obs, scene):
    names = [s["sceneName"] for s in obs.call("GetSceneList").get("scenes", [])]
    if scene not in names:
        obs.call("CreateScene", sceneName=scene)
        return True
    return False


def canvas_size(obs):
    data = obs.call("GetVideoSettings")
    return int(data.get("baseWidth", 1920)), int(data.get("baseHeight", 1080))


def ensure_browser_source(obs, scene, name, url, width, height, css=None):
    """Create or update a browser source and make sure it is in the scene.

    Returns (scene_item_id, changed).
    """
    inputs = {item["inputName"] for item in obs.call("GetInputList").get("inputs", [])}
    settings = {
        "url": url,
        "width": int(width),
        "height": int(height),
        "fps": 30,
        "shutdown_when_not_visible": False,
        "restart_when_active": False,
    }
    if css is not None:
        settings["css"] = css

    changed = False
    if name in inputs:
        old_url = obs.call("GetInputSettings", inputName=name).get(
            "inputSettings", {}).get("url")
        obs.call("SetInputSettings", inputName=name, inputSettings=settings, overlay=True)
        changed = old_url != url
    else:
        obs.call("CreateInput", sceneName=scene, inputName=name,
                 inputKind="browser_source", inputSettings=settings,
                 sceneItemEnabled=True)
        changed = True

    items = obs.call("GetSceneItemList", sceneName=scene).get("sceneItems", [])
    item = next((i for i in items if i["sourceName"] == name), None)
    if item is None:
        obs.call("CreateSceneItem", sceneName=scene, sourceName=name,
                 sceneItemEnabled=True)
        items = obs.call("GetSceneItemList", sceneName=scene).get("sceneItems", [])
        item = next(i for i in items if i["sourceName"] == name)
        changed = True

    if changed:
        with contextlib.suppress(ObsError):
            obs.call("PressInputPropertiesButton", inputName=name,
                     propertyName="refreshnocache")
    return item["sceneItemId"], changed


def fit_source(obs, scene, item_id):
    """Scale a source down to fit the canvas and center it."""
    cw, ch = canvas_size(obs)
    transform = obs.call("GetSceneItemTransform", sceneName=scene,
                         sceneItemId=item_id)["sceneItemTransform"]
    width = transform.get("sourceWidth") or cw
    height = transform.get("sourceHeight") or ch
    scale = min(cw / width, ch / height)
    obs.call("SetSceneItemTransform", sceneName=scene, sceneItemId=item_id,
             sceneItemTransform={
                 "positionX": (cw - width * scale) / 2,
                 "positionY": (ch - height * scale) / 2,
                 "scaleX": scale,
                 "scaleY": scale,
                 "alignment": 5,
                 "boundsType": "OBS_BOUNDS_NONE",
                 "rotation": 0.0,
             })
    return cw, ch


def fill_canvas(obs, scene, item_id):
    """Stretch a source to the whole canvas (used for the transparent overlay)."""
    cw, ch = canvas_size(obs)
    obs.call("SetSceneItemTransform", sceneName=scene, sceneItemId=item_id,
             sceneItemTransform={
                 "positionX": 0.0,
                 "positionY": 0.0,
                 "scaleX": 1.0,
                 "scaleY": 1.0,
                 "alignment": 5,
                 "boundsType": "OBS_BOUNDS_NONE",
                 "rotation": 0.0,
             })
    return cw, ch


