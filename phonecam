# argument parsing
# --------------------------------------------------------------------------

ALIASES = {"new", "url", "qr", "obs", "all", "refresh", "layout", "status",
           "enable-ws"}


def add_phone_new_arguments(parser):
    parser.add_argument("--room", help="VDO.Ninja room id (default: random)")
    parser.add_argument("--back", action="store_true", help="use the rear camera")
    parser.add_argument("--no-relay", dest="relay", action="store_false",
                        default=True, help="do not force the TURN relay")
    parser.add_argument("--p2p", action="store_true",
                        help="peer-to-peer only, no TURN")
    parser.add_argument("--codec", choices=["vp8", "vp9", "h264", "av1"],
                        help="preferred video codec")
    parser.add_argument("--bitrate", type=int, default=2500)
    parser.add_argument("--scene", help="OBS scene name")
    parser.add_argument("--activate", action="store_true",
                        help="switch OBS to this scene")
    parser.add_argument("--obs", action="store_true",
                        help="create the OBS source right away")


def build_parser():
    parser = argparse.ArgumentParser(
        prog=APP, description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Aliases: " + ", ".join(sorted(ALIASES)))
    parser.add_argument("--version", action="version", version=f"{APP} {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    start = sub.add_parser("start", help="start relay and prepare OBS sources")
    start.add_argument("--scene", help="OBS scene name")
    start.add_argument("--no-obs", action="store_true", help="do not touch OBS")
    start.add_argument("--no-activate", action="store_true",
                       help="do not switch the program scene")
    start.add_argument("--no-qr", action="store_true", help="do not draw the QR")
    start.set_defaults(func=cmd_start)

    doctor = sub.add_parser("doctor", help="check the environment")
    doctor.set_defaults(func=cmd_doctor)

    # ---- phone ----
    phone = sub.add_parser("phone", help="phone camera commands")
    phone_sub = phone.add_subparsers(dest="phone_command", required=True)

    new = phone_sub.add_parser("new", help="create a room and show the QR")
    add_phone_new_arguments(new)
    new.set_defaults(func=cmd_phone_new)

    url = phone_sub.add_parser("url", help="print the room URLs")
    url.set_defaults(func=cmd_phone_url)

    qr = phone_sub.add_parser("qr", help="regenerate the QR code")
    qr.add_argument("--open", action="store_true", help="open the PNG")
    qr.set_defaults(func=cmd_phone_qr)

    obs = phone_sub.add_parser("obs", help="create or update the browser source")
    obs.add_argument("--scene", help="OBS scene name")
    obs.add_argument("--activate", action="store_true")
    obs.set_defaults(func=cmd_phone_obs)

    refresh = phone_sub.add_parser("refresh", help="reload the browser source")
    refresh.set_defaults(func=cmd_phone_refresh)

    layout = phone_sub.add_parser("layout", help="fit the source to the canvas")
    layout.add_argument("--scene", help="OBS scene name")
    layout.set_defaults(func=cmd_phone_layout)

    status = phone_sub.add_parser("status", help="show the source state")
    status.set_defaults(func=cmd_phone_status)

    all_cmd = phone_sub.add_parser("all", help="new + obs")
    add_phone_new_arguments(all_cmd)
    all_cmd.set_defaults(func=cmd_phone_all)

    enable_ws = phone_sub.add_parser("enable-ws", help="enable obs-websocket")
    enable_ws.set_defaults(func=cmd_phone_enable_ws)

    # ---- lovense ----
    lovense = sub.add_parser("lovense", help="Lovense widget commands")
    lovense_sub = lovense.add_subparsers(dest="lovense_command", required=True)

    setup = lovense_sub.add_parser("setup", help="install the widget")
    setup.add_argument("--download", action="store_true",
                       help="download the official installer even if the widget exists")
    setup.add_argument("--installer", help="use a local Lovense_OBS_Toolset_x64.exe")
    setup.add_argument("--to", help="install the widget to this directory")
    setup.add_argument("--force", action="store_true",
                       help="ignore the cached installer")
    setup.set_defaults(func=cmd_lovense_setup)

    extension = lovense_sub.add_parser("extension", help="install or patch the Chrome extension")
    extension.add_argument("--dir", help="patch this unpacked extension in place")
    extension.add_argument("--force", action="store_true",
                           help="download a fresh extension archive")
    extension.set_defaults(func=cmd_lovense_extension)

    l_obs = lovense_sub.add_parser("obs", help="create or update the widget source")
    l_obs.add_argument("--scene", help="OBS scene name")
    l_obs.add_argument("--activate", action="store_true")
    l_obs.set_defaults(func=cmd_lovense_obs)

    relay = lovense_sub.add_parser("relay", help="run the relay in the foreground")
    relay.add_argument("--foreground", action="store_true", help=argparse.SUPPRESS)
    relay.set_defaults(func=cmd_lovense_relay)

    l_start = lovense_sub.add_parser("start", help="start the relay service")
    l_start.set_defaults(func=cmd_lovense_start)

    l_stop = lovense_sub.add_parser("stop", help="stop the relay service")
    l_stop.set_defaults(func=cmd_lovense_stop)

    l_restart = lovense_sub.add_parser("restart", help="restart the relay service")
    l_restart.set_defaults(func=cmd_lovense_restart)

    l_status = lovense_sub.add_parser("status", help="show the relay state")
    l_status.set_defaults(func=cmd_lovense_status)

    service = lovense_sub.add_parser("service", help="manage the systemd user unit")
    service.add_argument("action", choices=["install", "uninstall", "status"])
    service.set_defaults(func=cmd_lovense_service)

    return parser


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in ALIASES:
        argv.insert(0, "phone")
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        args.func(args)
    except ObsError as exc:
        die(str(exc))
    except KeyboardInterrupt:
        say("\ninterrupted")


if __name__ == "__main__":
    main()
