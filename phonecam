class RelayState:
    def __init__(self):
        self.widgets = set()
        self.panels = set()
        self.last_switch = None
        self.started = time.time()


SWITCH_MESSAGE = {
    "type": "101",
    "to": UID,
    "from": "cam",
    "data": {"type": "switchConnectClient",
             "data": {"value": "obs", "version": "31.6.9"}},
}


def panel_hello(state):
    return {
        "type": "105",
        "to": UID,
        "data": {
            "version": "1.0.0",
            "toolSetVersion": "3.0.1",
            "connect": 2,  # 1=lvs-obs, 2=obs, 3=splitcam, 4=streamster
            "smartOnline": bool(state.widgets),
            "pcId": UID,
            "camName": "OBS",
            "setCamEmail": UID,
            "resolutionRatio": "16:9",
            "frameRate": 30,
            "stream_v": "1.0.0",
            "video_snapshot_version": "1.0.0",
            "fdSupport": False,
            "handSupport": False,
            "vibeMateTipMotionSupport": "1",
            "stream": {"record_status": 0, "record_dir": ""},
            "system_info": {"cpuName": ""},
        },
    }


def widget_hello():
    return {
        "type": "105",
        "to": UID,
        "data": {
            "version": "1.0.0",
            "toolSetVersion": "3.0.1",
            "smartOnline": True,
            "pcId": UID,
            "setCamEmail": UID,
        },
    }


async def relay_handler(connection, state, obs):
    path = connection.request.path
    query = path.split("?", 1)[1] if "?" in path else ""
    params = dict(part.split("=", 1) for part in query.split("&") if "=" in part)
    origin = params.get("from", "")

    hello_task = None
    if origin == "smart":
        state.widgets.add(connection)
        log(f"widget connected ({len(state.widgets)} online)")
        with contextlib.suppress(Exception):
            await connection.send(encrypt(widget_hello()))
            await connection.send(encrypt(state.last_switch or SWITCH_MESSAGE))
    elif origin == "cam":
        state.panels.add(connection)
        log(f"panel connected ({len(state.panels)} online)")
        with contextlib.suppress(Exception):
            await connection.send(encrypt(panel_hello(state)))

        async def hello_loop():
            while True:
                await asyncio.sleep(4)
                try:
                    await connection.send(encrypt(panel_hello(state)))
                    log_slow("hello_repeat", "panel hello repeated", 60.0)
                except Exception:
                    return

        hello_task = asyncio.create_task(hello_loop())

    try:
        async for raw in connection:
            message, method = parse_message(raw)
            if message is None:
                log(f"bad frame from {origin or 'unknown'} ({method})")
                continue

            mtype = str(message.get("type"))
            if mtype not in ("101", "103", "105", "110", "202", "209", "360"):
                log_slow(("msg", origin, mtype),
                         f"message from={origin} type={mtype} method={method}")

            if mtype == "103":
                reply = {"type": "103", "to": UID,
                         "from": "cam" if origin == "smart" else "smart"}
                with contextlib.suppress(Exception):
                    await connection.send(encrypt(reply))
                continue

            if origin == "cam" and message.get("request_type"):
                request_type, response = await answer_request(obs, message)
                log(f"OBS request {request_type} -> "
                    f"{json.dumps(response, ensure_ascii=False)[:180]}")
                with contextlib.suppress(Exception):
                    await connection.send(encrypt(response))
                with contextlib.suppress(Exception):
                    if request_type in ("ActiveOBSCamera", "ShowOBSApplication"):
                        await connection.send(encrypt({
                            "update_type": "OBSApplicationShowChanged", "show": True}))
                    elif request_type == "GetSceneList":
                        scenes = response.get("scenes", [])
                        await connection.send(encrypt({
                            "update_type": "ScenesChanged", "scenes": scenes}))
                continue

            if origin == "cam" and mtype == "105":
                with contextlib.suppress(Exception):
                    await connection.send(encrypt(message))
                continue

            if origin == "smart":
                for panel in list(state.panels):
                    try:
                        await panel.send(encrypt(message))
                    except Exception:
                        state.panels.discard(panel)
            elif origin == "cam":
                data = message.get("data")
                if isinstance(data, dict) and data.get("type") == "switchConnectClient":
                    state.last_switch = message
                    log("cached switchConnectClient")
                for widget in list(state.widgets):
                    try:
                        await widget.send(encrypt(message))
                    except Exception:
                        state.widgets.discard(widget)
    except Exception as exc:
        log(f"connection from {origin or 'unknown'}: {exc}")
    finally:
        if hello_task:
            hello_task.cancel()
        if connection in state.widgets:
            state.widgets.discard(connection)
            log("widget disconnected")
        if connection in state.panels:
            state.panels.discard(connection)
            log("panel disconnected")


async def proxy_handler(client):
    """The extension dials localhost:20996; bridge it to the relay as a panel."""
    url = f"ws://{RELAY_HOST}:{RELAY_PORT}/smartcam/ws?from=cam"
    try:
        relay = await websockets.connect(url, max_size=None, ping_interval=None,
                                         open_timeout=5)
    except Exception as exc:
        log(f"proxy: relay unavailable ({exc})")
        with contextlib.suppress(Exception):
            await client.close(1011, "relay unavailable")
        return

    async def pump(source, target):
        try:
            async for raw in source:
                await target.send(raw)
        except Exception:
            pass

    tasks = [asyncio.create_task(pump(client, relay)),
             asyncio.create_task(pump(relay, client))]
    done, pending = await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)
    for task in pending:
        task.cancel()
    for task in done:
        with contextlib.suppress(Exception):
            task.result()
    with contextlib.suppress(Exception):
        await relay.close()
    with contextlib.suppress(Exception):
        await client.close()


def relay_health(timeout=1.0):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{HTTP_PORT}/health",
                                    timeout=timeout) as response:
            return json.loads(response.read().decode())
    except Exception:
        return None


def http_app(state, obs, widget):
    app = _web.Application()

    async def health(request):
        payload = {
            "app": APP,
            "version": VERSION,
            "uptime": round(time.time() - state.started, 1),
            "relay": {"port": RELAY_PORT,
                      "panels": len(state.panels),
                      "widgets": len(state.widgets)},
            "obs": {"connected": bool(obs and obs.connected),
                    "scene": None},
            "widget": str(widget) if widget else None,
        }
        if obs is not None and await obs.ensure():
            payload["obs"]["connected"] = True
            with contextlib.suppress(Exception):
                data = await obs.call("GetCurrentProgramScene", timeout=1)
                payload["obs"]["scene"] = data.get("currentProgramSceneName")
        return _web.json_response(payload)

    async def static(request):
        if widget is None:
            return _web.Response(status=503, text="Lovense widget is not installed\n")
        relative = request.match_info.get("path", "").lstrip("/")
        base = widget.resolve()
        target = (base / relative).resolve() if relative else base / "index.html"
        if not target.is_relative_to(base):
            raise _web.HTTPForbidden()
        if target.is_dir():
            target = target / "index.html"
        if not target.is_file():
            if "." in Path(relative).name:
                raise _web.HTTPNotFound()
            target = base / "index.html"
        return _web.FileResponse(target)

    app.router.add_get("/health", health)
    app.router.add_get("/{path:.*}", static)
    return app


async def run_relay():
    if websockets is None:
        die("python-websockets is required for the relay")
    if not HAVE_AIOHTTP:
        die("python-aiohttp is required for the relay")
    if not HAVE_CRYPTO:
        die("python-cryptography is required for the relay")

    widget = find_widget()
    if widget is None:
        warn("Lovense widget not installed; /health will work but OBS will show nothing")
        warn("run: phonecam lovense setup")
    else:
        log(f"widget: {widget} ({widget_version(widget)})")

    try:
        obs = AsyncObs.from_config()
    except ObsError as exc:
        log(f"OBS integration disabled: {exc}")
        obs = None

    state = RelayState()
    runner = _web.AppRunner(http_app(state, obs, widget))
    await runner.setup()
    await _web.TCPSite(runner, RELAY_HOST, HTTP_PORT).start()
    log(f"http: http://{RELAY_HOST}:{HTTP_PORT}/ (widget, /health)")

    proxy_servers = []
    for host in (RELAY_HOST, "::1"):
        try:
            proxy_servers.append(await websockets.serve(
                proxy_handler, host, PROXY_PORT, max_size=None, ping_interval=None))
        except OSError as exc:
            log(f"proxy bind {host}:{PROXY_PORT} failed: {exc}")
    if not proxy_servers:
        await runner.cleanup()
        die(f"cannot bind proxy port {PROXY_PORT}")

    handler = functools.partial(relay_handler, state=state, obs=obs)
    try:
        async with websockets.serve(handler, RELAY_HOST, RELAY_PORT,
                                    max_size=None, ping_interval=None):
            log(f"relay listening on ws://{RELAY_HOST}:{RELAY_PORT}/smartcam/ws")
            log(f"proxy listening on ws://{RELAY_HOST}:{PROXY_PORT} (panel)")
            await asyncio.Future()
    finally:
        for server in proxy_servers:
            server.close()
            await server.wait_closed()
        await runner.cleanup()


