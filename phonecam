def phone_urls(cfg):
    facing = "&facing=environment" if cfg.get("back") else ""
    extra = ""
    if cfg.get("relay") and not cfg.get("p2p"):
        extra += "&relay"
    if cfg.get("p2p"):
        extra += "&turn=0"
    codec = cfg.get("codec")
    push_extra = extra + (f"&prefervideocodec={codec}" if codec else "")
    view_extra = extra + (f"&codec={codec}" if codec else "")
    push = PUSH_URL.format(room=cfg.get("room", ""), bitrate=cfg.get("bitrate", 2500),
                           facing=facing, extra=push_extra)
    view = VIEW_URL.format(room=cfg.get("room", ""), extra=view_extra)
    return push, view


