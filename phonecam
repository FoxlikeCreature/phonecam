def systemctl(*arguments):
    return subprocess.run(["systemctl", "--user", *arguments],
                          capture_output=True, text=True)


def unit_text():
    return f"""[Unit]
Description=phonecam Lovense relay
After=network.target

[Service]
Type=simple
ExecStart={shlex.quote(str(SCRIPT_DIR / 'phonecam'))} lovense relay --foreground
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
"""


def service_install(quiet=False):
    if not have("systemctl"):
        die("systemd is not available")
    SYSTEMD_DIR.mkdir(parents=True, exist_ok=True)
    UNIT_PATH.write_text(unit_text())
    legacy = SYSTEMD_DIR / LEGACY_UNIT
    if legacy.is_file():
        systemctl("stop", LEGACY_UNIT)
        systemctl("disable", LEGACY_UNIT)
        if not quiet:
            warn(f"legacy unit {LEGACY_UNIT} stopped and disabled "
                 f"(file kept at {legacy})")
    systemctl("daemon-reload")
    systemctl("enable", UNIT_NAME)
    if not quiet:
        ok(f"service installed and enabled: {UNIT_PATH}")


def service_active():
    if not UNIT_PATH.is_file():
        return "not installed"
    result = systemctl("is-active", UNIT_NAME)
    return result.stdout.strip() or "unknown"


def service_enabled():
    if not UNIT_PATH.is_file():
        return False
    return systemctl("is-enabled", UNIT_NAME).stdout.strip() == "enabled"


def service_uninstall():
    systemctl("stop", UNIT_NAME)
    systemctl("disable", UNIT_NAME)
    if UNIT_PATH.is_file():
        UNIT_PATH.unlink()
        ok(f"removed {UNIT_PATH}")
    systemctl("daemon-reload")


def ensure_relay(quiet=False):
    health = relay_health()
    if health and health.get("app") == APP:
        if not quiet:
            ok(f"relay already running on port {HTTP_PORT}")
        return True
    if not UNIT_PATH.is_file() or UNIT_PATH.read_text() != unit_text():
        service_install(quiet=True)
    result = systemctl("start", UNIT_NAME)
    if result.returncode != 0:
        warn(f"could not start service: {(result.stderr or result.stdout).strip()}")
    for _ in range(40):
        health = relay_health(0.3)
        if health and health.get("app") == APP:
            if not quiet:
                ok(f"relay started (service {UNIT_NAME})")
            return True
        time.sleep(0.25)
    warn(f"relay did not answer on http://127.0.0.1:{HTTP_PORT}/health")
    return False


def cmd_lovense_service(args):
    if args.action == "install":
        service_install()
        say("  start:   phonecam lovense start")
    elif args.action == "uninstall":
        service_uninstall()
        ok("service stopped and removed")
    elif args.action == "status":
        say(f"unit:    {UNIT_PATH} ({'present' if UNIT_PATH.is_file() else 'missing'})")
        say(f"active:  {service_active()}")
        say(f"enabled: {'yes' if service_enabled() else 'no'}")


def cmd_lovense_start(args):
    if ensure_relay():
        health = relay_health() or {}
        relay = health.get("relay", {})
        ok(f"panels={relay.get('panels', 0)} widgets={relay.get('widgets', 0)} "
           f"http://127.0.0.1:{HTTP_PORT}/")


def cmd_lovense_stop(args):
    if not UNIT_PATH.is_file():
        warn("service is not installed")
        return
    systemctl("stop", UNIT_NAME)
    ok("relay stopped")


def cmd_lovense_restart(args):
    ensure_relay(quiet=True)
    systemctl("restart", UNIT_NAME)
    for _ in range(40):
        if relay_health(0.3):
            ok("relay restarted")
            return
        time.sleep(0.25)
    warn("relay did not come back")


